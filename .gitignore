# Local provider plugins (rebuilt by `terraform init`)
.terraform/

# State files can contain account IDs and secrets
*.tfstate
*.tfstate.*
.terraform.tfstate.lock.info

# Variable files may contain secrets
*.tfvars
*.tfvars.json

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config
.terraformrc
terraform.rc
